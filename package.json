{
  "name": "parcelguard",
  "version": "0.0.0",
  "private": true,
  "description": "Stop losing money on returned cash-on-delivery parcels.",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm codegen && pnpm --recursive --parallel dev",
    "build": "pnpm --recursive build",
    "build:shared": "pnpm --filter @parcelguard/shared build",
    "codegen": "pnpm build:shared && pnpm --filter @parcelguard/api db:generate",
    "lint": "pnpm codegen && pnpm --recursive lint",
    "typecheck": "pnpm codegen && pnpm --recursive typecheck",
    "test": "pnpm codegen && pnpm --recursive test",
    "test:db": "pnpm codegen && pnpm --filter @parcelguard/api test:db",
    "db:migrate": "pnpm --filter @parcelguard/api db:migrate",
    "db:deploy": "pnpm --filter @parcelguard/api db:deploy",
    "db:seed": "pnpm --filter @parcelguard/api db:seed",
    "db:reset": "pnpm --filter @parcelguard/api db:reset",
    "db:status": "pnpm --filter @parcelguard/api db:status",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
