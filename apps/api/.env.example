# Copy to apps/api/.env and adjust. .env is git-ignored; never commit real secrets.

# Port the API listens on. The web app proxies /api/* here.
PORT=4000

# Not used yet. Prisma reads this from F1, BullMQ uses REDIS_URL from F9.
# These values match docker-compose.yml.
DATABASE_URL=postgresql://parcelguard:parcelguard@localhost:5432/parcelguard
REDIS_URL=redis://localhost:6379
